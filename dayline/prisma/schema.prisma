generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js tables ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  preferences Preferences?
  classes     ClassBlock[]
  tasks       Task[]
  localEvents LocalEvent[]
}

// access_token and refresh_token are stored encrypted (AES-256-GCM, see lib/crypto.ts).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  needsReauth       Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Dayline tables ----------

model Preferences {
  userId   String @id
  dayStart String @default("07:00")
  dayEnd   String @default("21:00")
  focus    String @default("early") // early | late | afternoon | evening
  lunch    String @default("12:30")
  blockMin Int    @default(90)
  breakMin Int    @default(15)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClassBlock {
  id       String  @id @default(cuid())
  userId   String
  name     String
  days     Int[]
  start    String
  end      String
  location String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String
  estMin    Int       @default(30)
  deep      Boolean   @default(false)
  priority  String    @default("medium") // high | medium | low
  due       DateTime? @db.Date
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LocalEvent {
  id     String   @id @default(cuid())
  userId String
  title  String
  date   DateTime @db.Date
  start  String
  end    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
