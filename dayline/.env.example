# Copy to .env.local (Next.js) — the Prisma CLI reads .env, so keep both in sync
# or symlink: ln -s .env.local .env

# Postgres (Neon / Vercel Postgres / local). Neon needs ?sslmode=require
DATABASE_URL="postgresql://dayline:dayline@localhost:5432/dayline"
# Optional: Neon "unpooled" connection string, used only by prisma migrate
# DIRECT_DATABASE_URL=""

# Auth.js — `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=""
# Only needed outside Vercel/localhost when the public URL can't be inferred
# AUTH_URL="https://app.soichirosaimon.com"

# Google Cloud Console → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra → App registration (multi-tenant + personal accounts)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# 32 random bytes, base64 — `openssl rand -base64 32`. Encrypts OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=""
